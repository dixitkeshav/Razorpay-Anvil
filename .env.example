# Razorpay test-mode credentials — https://dashboard.razorpay.com/app/keys
# Test-mode keys only. Never put live keys here or anywhere in this repo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — used only by src/llm/ (L9, read-only, terminal)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to 1 to force src/llm/ to use fixtures/llm_cache.json instead of the
# live API — used for offline/reproducible test runs.
ANVIL_LLM_OFFLINE=0
